{
  // ── A2【P0】修复：开启 TypeScript 严格模式（详见《深度技术分析报告》§A2）──
  // 实证结论（2026-08-18）：存量代码在 strict 下仅 11 处错误，已全部以纯类型修正
  // 方式修复（不改变任何运行时行为），因此无需"仅新文件生效"的豁免期，
  // 直接启用完整 strict，使 CI 的 typecheck 步骤立即获得全量严格校验。
  // 新增代码一律必须通过严格检查；严禁在业务代码中使用 `any`（确需绕过时用
  // `unknown` + 类型收窄，并附注释说明原因）。
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "lib": [
      "ES2023",
      "DOM",
      "DOM.Iterable"
    ],
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "isolatedModules": true,
    "moduleDetection": "force",
    "allowJs": true,
    "jsx": "react-jsx",
    "paths": {
      "@/*": [
        "./src/*"
      ],
      "@/server/*": [
        "./server/*"
      ]
    },
    "allowImportingTsExtensions": true,
    "noEmit": true,
    // ── 严格模式（A2 开启）──
    "strict": true,
    "noImplicitAny": true,
    "strictNullChecks": true,
    "noFallthroughCasesInSwitch": true,
    "forceConsistentCasingInFileNames": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "incremental": true,
    "esModuleInterop": true,
    "resolveJsonModule": true
  },
  "include": [
    "next-env.d.ts",
    ".next/types/**/*.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/dev/types/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "src/server",
    "src/app/api/billing",
    "src/app/api/notices/actions",
    "src/app/api/notices/[id]/translation",
    "src/app/api/payment/notify"
  ]
}
