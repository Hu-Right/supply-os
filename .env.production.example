# ============================================================
# Supply-OS 生产环境变量模板
# ============================================================
# 使用方式:
#   cp .env.production.example .env.production
#   然后填写所有必填项，切勿将 .env.production 提交到 Git
#
# 生成随机密钥:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# ============================================================

# ── Database (必填) ──────────────────────────────────────────
# Docker Compose 中 DB_HOST 自动设为 mysql 服务名，无需手动配置
DB_USER=root
DB_PASSWORD=<替换为强密码>
DB_NAME=crm
DB_POOL_LIMIT=20

# ── JWT 认证 (必填) ──────────────────────────────────────────
JWT_SECRET=<运行: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))">

# ── 应用域名 (必填) ──────────────────────────────────────────
APP_URL=https://your-domain.com
ALLOWED_ORIGINS=https://your-domain.com

# ── CSRF 防护 ────────────────────────────────────────────────
CSRF_ENABLED=true

# ── 支付 (必填一项) ──────────────────────────────────────────
PAYMENT_MODE=live

# 支付宝
ALIPAY_APP_ID=
ALIPAY_PRIVATE_KEY=
ALIPAY_PUBLIC_KEY=
ALIPAY_NOTIFY_URL=https://your-domain.com/api/payment/notify/alipay
ALIPAY_SANDBOX=false

# 微信支付
WECHAT_APP_ID=
WECHAT_MCH_ID=
WECHAT_API_V3_KEY=
WECHAT_PRIVATE_KEY=
WECHAT_NOTIFY_URL=https://your-domain.com/api/payment/notify/wechat

# ── Meilisearch (可选，启用时设 MEILI_ENABLED=on) ────────────
MEILI_ENABLED=off
MEILI_MASTER_KEY=<运行: node -e "console.log(require('crypto').randomBytes(16).toString('hex'))">
MEILI_MAX_TOTAL_HITS=10000000

# ── AI 翻译通道 (至少配一个) ─────────────────────────────────
GEMINI_API_KEY=
DEEPSEEK_API_KEY=

# 自动翻译
NOTICE_AUTO_TRANSLATE=on
NOTICE_AUTO_TRANSLATE_INTERVAL_MS=600000
NOTICE_AUTO_TRANSLATE_MAX=300
NOTICE_AUTO_TRANSLATE_DESC_MAX_CHARS=8000
NOTICE_AUTO_TRANSLATE_DAILY_CHARS=7000000

# ── SMTP 邮件 (必填) ─────────────────────────────────────────
SMTP_HOST=smtpdm.aliyun.com
SMTP_PORT=465
SMTP_USER=noreply@your-domain.com
SMTP_PASS=<邮件服务密码>
SMTP_FROM=国际采购供应链平台 <noreply@your-domain.com>

# ── 短信服务 (必填) ──────────────────────────────────────────
SMS_PROVIDER=aliyun
SMS_ACCESS_KEY_ID=
SMS_ACCESS_KEY_SECRET=
SMS_SIGN_NAME=<签名>
SMS_TEMPLATE_CODE=<模板ID>
SMS_TEMPLATE_CODE_RESET=<找回密码模板ID>

# ── 告警 (可选) ──────────────────────────────────────────────
ALERT_WEBHOOK_URL=

# ── 优雅关闭超时 (可选，默认 10s) ────────────────────────────
SHUTDOWN_TIMEOUT_MS=10000
