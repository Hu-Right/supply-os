# ============================================================
# Supply-OS 生产环境变量模板
# ============================================================
# 使用方式:
#   cp .env.production.example .env.production
#   然后填写所有必填项，切勿将 .env.production 提交到 Git
#
# 生成随机密钥:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# ============================================================

# ── Database (必填) ──────────────────────────────────────────
# Docker Compose 中 DB_HOST 自动设为 mysql 服务名，无需手动配置
DB_USER=root
DB_PASSWORD=<替换为强密码>
DB_NAME=crm
DB_POOL_LIMIT=20

# ── JWT 认证 (必填) ──────────────────────────────────────────
JWT_SECRET=<运行: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))">

# ── 应用域名 (必填) ──────────────────────────────────────────
APP_URL=https://your-domain.com
ALLOWED_ORIGINS=https://your-domain.com

# ── CSRF 防护 ────────────────────────────────────────────────
CSRF_ENABLED=true

# ── 支付 (必填一项) ──────────────────────────────────────────
PAYMENT_MODE=live

# 支付宝
ALIPAY_APP_ID=
ALIPAY_PRIVATE_KEY=
ALIPAY_PUBLIC_KEY=
ALIPAY_NOTIFY_URL=https://your-domain.com/api/payment/notify/alipay
ALIPAY_SANDBOX=false

# 微信支付
WECHAT_APP_ID=
WECHAT_MCH_ID=
WECHAT_API_V3_KEY=
WECHAT_PRIVATE_KEY=
WECHAT_NOTIFY_URL=https://your-domain.com/api/payment/notify/wechat

# ── Meilisearch (可选，启用时设 MEILI_ENABLED=on) ────────────
MEILI_ENABLED=off
MEILI_MASTER_KEY=<运行: node -e "console.log(require('crypto').randomBytes(16).toString('hex'))">
MEILI_MAX_TOTAL_HITS=10000000

# ── AI 翻译通道 (至少配一个) ─────────────────────────────────
GEMINI_API_KEY=
DEEPSEEK_API_KEY=

# ── AI 拆标摘要 BYOK (必填) ─────────────────────────────────
# 用户自带 API Key 的 AES-256-GCM 加密密钥。缺失时：llm-config 保存 500、
# 已存 Key 全部无法解密（AI 摘要报"未配置"）；换新值同样导致已存 Key 失效。
LLM_KEY_SECRET=<运行: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))">

# ── SMTP 邮件（必填） ────────────────────────────────────────
# 阿里云邮件推送 DirectMail。发件域使用平台自有域的独立发信子域
# mail.osneosmart.com（与官网/营销隔离发信信誉）。
# 前置条件：DirectMail 控制台已添加该发信域名，并配好 SPF / DKIM / DMARC / MX；
# 未完成 DNS 认证时海外收件方（Gmail/Outlook）会判垃圾或拒收。
# 上线前自检：npm run check:email-dns -- --domain mail.osneosmart.com
SMTP_HOST=smtpdm.aliyun.com
SMTP_PORT=465
SMTP_USER=noreply@mail.osneosmart.com
SMTP_PASS=<DirectMail 控制台为该发信地址设置的 SMTP 密码>
SMTP_FROM=云境·国际采购平台 <noreply@mail.osneosmart.com>
# 回复地址（可选）：填公司真实可收信邮箱，用户点「回复」才不会回到 noreply。
SMTP_REPLY_TO=service@neosilks.com
# 应用侧 DKIM 签名（可选）：SMTP 服务商已在服务端签名时留空；三项齐全才启用
SMTP_DKIM_DOMAIN=
SMTP_DKIM_SELECTOR=
SMTP_DKIM_PRIVATE_KEY=

# 站外绝对链接单一事实源（邮件内链接/SEO；务必填真实生产域名）
SITE_URL=https://your-domain.com
# RFQ 契约哨兵周期对账（建议 on）
RFQ_GUARD_ENABLED=on
# RFQ 发布邀约邮件群发（默认 off：需精确匹配与人工放行后再开）
RFQ_OUTREACH_ENABLED=off

# ── 短信服务 (必填) ──────────────────────────────────────────
SMS_PROVIDER=aliyun
SMS_ACCESS_KEY_ID=
SMS_ACCESS_KEY_SECRET=
SMS_SIGN_NAME=<国内短信签名>
SMS_TEMPLATE_CODE=<国内验证码模板ID>
SMS_TEMPLATE_CODE_RESET=<国内找回密码模板ID>
# 国际/港澳台短信：新版「国际/港澳台 API」（SendMessageToGlobe）无需国际签名/模板，
# 使用 Sender ID + 直接短信正文；在控制台「国际/港澳台短信 → 国际消息设置」配置频率/有效期，
# 部分国家/地区需先报备 Sender ID。未配置时非 +86 号码会被拒绝（返回“通道未开通”）。
SMS_INTL_SENDER_ID=
# 可选：国际短信 API 端点（默认 dysmsapi.ap-southeast-1.aliyuncs.com，国际/港澳台 API 专用）
SMS_INTL_ENDPOINT=
# 可选：自定义国际短信正文（{code} 占位；不配用内置英文文案）
SMS_INTL_MESSAGE_VERIFY=
SMS_INTL_MESSAGE_RESET=

# ── 告警 (可选) ──────────────────────────────────────────────
ALERT_WEBHOOK_URL=

# ── 优雅关闭超时 (可选，默认 10s) ────────────────────────────
SHUTDOWN_TIMEOUT_MS=10000

# ── 应用文件日志目录 (建议显式配置) ──────────────────────────
# createLogger 的输出目录；不配则落 <cwd>/logs（standalone 运行时 cwd 是 .next/standalone，
# 日志会随部署被覆盖）。生产建议指向 /var/log/supply-os 并交给 logrotate 轮转。
# 2026-11-13 修复：此前用 __dirname 推导，构建机路径 /ROOT 被烧进产物，日志误写到 /ROOT/src/lib/logs。
LOG_DIR=/var/log/supply-os
