{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "node ./node_modules/tsx/dist/cli.mjs server.ts",
    "build": "node ./node_modules/vite/bin/vite.js build && (node scripts/generate-version.mjs || echo [version] skipped) && node ./node_modules/esbuild/bin/esbuild server.ts --bundle --platform=node --format=esm --packages=external --sourcemap --outfile=dist/server.mjs",
    "preview": "node ./node_modules/vite/bin/vite.js preview",
    "start": "set NODE_ENV=production&& node dist/server.mjs",
    "clean": "node -e \"const fs=require('fs');['dist','server.js'].forEach(p=>{try{fs.rmSync(p,{recursive:true,force:true})}catch{}})\"",
    "lint": "npm run check:encoding && eslint src/",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write \"src/**/*.{ts,tsx,js,jsx,json,css,md}\"",
    "check-i18n": "npx tsx scripts/check-i18n.ts",
    "check:encoding": "node scripts/check-mojibake.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@alicloud/dypnsapi20170525": "^2.0.0",
    "@alicloud/dysmsapi20170525": "^4.6.0",
    "@alicloud/openapi-client": "^0.4.15",
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "alipay-sdk": "^4.14.0",
    "bcrypt": "^6.0.0",
    "compression": "^1.8.1",
    "docx": "^9.7.1",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "helmet": "^8.3.0",
    "i18next": "^26.3.6",
    "jsonwebtoken": "^9.0.3",
    "lru-cache": "^11.5.2",
    "lucide-react": "^0.546.0",
    "meilisearch": "^0.60.0",
    "mysql2": "^3.22.4",
    "nodejieba": "^3.5.8",
    "nodemailer": "^9.0.5",
    "qrcode": "^1.5.4",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "react-i18next": "^17.0.10",
    "react-router-dom": "^7.18.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.6.0",
    "tinyld": "^1.3.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@types/bcrypt": "^6.0.0",
    "@types/compression": "^1.8.1",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^24.0.0",
    "@types/nodemailer": "^8.0.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/supertest": "^7.2.1",
    "@vitest/coverage-v8": "^4.1.10",
    "esbuild": "^0.25.0",
    "eslint": "^10.8.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jsdom": "^29.1.1",
    "mammoth": "^1.12.0",
    "msw": "^2.15.0",
    "prettier": "^3.9.6",
    "sharp": "^0.35.3",
    "supertest": "^7.2.2",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "typescript-eslint": "^8.67.0",
    "vite": "^6.2.3",
    "vitest": "^4.1.10"
  }
}
