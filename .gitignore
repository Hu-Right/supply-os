*.tmp
*.temp
~$*
*.swp
*.swo
scripts/*
!scripts/coverage-gate.mjs
!scripts/seed-test-db.ts
!scripts/perf-budget-check.ts
!scripts/deploy.sh
!scripts/migrate-licenses-to-runtime.mjs
!scripts/check-i18n.ts
!scripts/check-no-admin-routes.mjs
!scripts/css-compat-gate.mjs
# 用户主表 crm_users 影子表蓝绿切换的三阶段工具（ADR-0003）：
# 切换步骤本身依赖这些脚本执行，不入版本控制就等于切换流程只存在于单机，
# 机器故障/换人接手即丢失。与已跟踪的 shadow-wide-phase*.ts 同一先例。
!scripts/shadow-users-phase1.mjs
!scripts/shadow-users-phase2-align.mjs
!scripts/shadow-users-phase3-cutover.mjs
# crm_consent_log 影子表蓝绿切换两阶段工具（ADR-0003）：同上先例——切换步骤依赖这些脚本执行，
# 不入版本控制就等于流程只存在于单机；阶段二的两个确认位闸口也必须能被后人原样复用。
!scripts/consent-log-shadow-phase1.mjs
!scripts/consent-log-shadow-phase2-cutover.mjs
# supplier 供应商主表影子重建三阶段工具（2026-09，ADR-0003）：同上先例——删 7 列/物理吸收
# 裁决 duplicate/id 重排的执行步骤依赖这些脚本，不入版本控制等于流程只存在于单机。
!scripts/supplier-shadow-phase1.mjs
!scripts/supplier-shadow-phase2-align.mjs
!scripts/supplier-shadow-phase3-cutover.mjs
# crm_benefit_catalog 列精简影子表两阶段工具（2026-09-29，ADR-0003）：同上先例——
# 删 6 列 + sort_order 重编号 + 外键重建全靠这两个脚本执行，不入版本控制等于切换流程只存在于单机。
!scripts/benefit-catalog-shadow-phase1.mjs
!scripts/benefit-catalog-shadow-phase2-cutover.mjs
# 主表 sort_order 重编号（切换前置，方案 §1.2）：回滚靠它，必须与阶段脚本同处版本控制
!scripts/benefit-catalog-renumber-main.mjs
!scripts/lib/
scripts/lib/*
!scripts/lib/css-compat.mjs
# 影子表切换的唯一映射表（阶段一/重编号/回滚三处共用，不可各写一份）
!scripts/lib/benefit-catalog-sort-map.mjs
runtime/
backups/
bin/
dumps/
logs/
server/logs/

