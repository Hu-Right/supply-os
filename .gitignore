# ===== 依赖与构建产物 =====
node_modules/
build/
dist/
coverage/
*.tsbuildinfo
.vite/
.cache/
.next/
.mimosa/

# ===== 敏感配置(保留 .env.example)=====
.env*
!.env.example
!.env.production.example

# ===== 日志与临时文件 =====
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
*.tmp
*.temp
~$*
*.swp
*.swo
scripts/*
# ===== 构建 / 部署 / 校验管线调用（缺一即流程断，属运行必需）=====
!scripts/coverage-gate.mjs
!scripts/seed-test-db.ts
!scripts/perf-budget-check.ts
!scripts/deploy.sh
!scripts/migrate-licenses-to-runtime.mjs
!scripts/check-i18n.ts
!scripts/check-no-admin-routes.mjs
!scripts/css-compat-gate.mjs
# 以下 4 个早于本白名单机制就已入索引，一直靠「已跟踪」隐身携带（改了不出现在
# git status、换机 clone 拿不到）。补齐规则使索引与工作区口径一致：
# check-mojibake → npm run check:encoding（lint / pre-push 第一步）
# check-wide-table-ssot → npm run check:wide-ssot
# serve-style-smoke → playwright.styles.config.ts 的 webServer
# daily-sync → 数据库同步权威实现，自动调度已停用，保留作手动应急兜底
!scripts/check-mojibake.mjs
!scripts/check-wide-table-ssot.mjs
!scripts/serve-style-smoke.mjs
!scripts/daily-sync.cjs
# scripts/lib 下只放行 css-compat-gate 的实际依赖。
# 顺序不可改：必须先用 !scripts/lib/ 让 git 进入该目录，再整体忽略内容、单独放行文件；
# 若只写 scripts/lib/*，css-compat.mjs 会被目录级忽略吃掉（已实测）。
!scripts/lib/
scripts/lib/*
!scripts/lib/css-compat.mjs
# 权益约束静态校验探针：非构建/部署必需，跑的是生产库，停止跟踪（本地文件保留）
scripts/verify-benefit-constraints.ts
# ===== 以下为一次性数据库切换工具（ADR-0003 影子表蓝绿切换）=====
# 历史上曾按「切换流程不能只存在于单机」的理由白名单放行；截至 2026-09-29
# users / consent_log / supplier / benefit_catalog 四套切换均已收尾，这些脚本
# 不再属于「项目运行必需」，按非必要不上传原则停止跟踪（git rm --cached，本地文件保留）。
# 若将来再做同类切换，参照 docs/adr/0003 与仍然跟踪中的历史阶段脚本写法重新放行。
runtime/
backups/
bin/
dumps/
logs/
server/logs/

