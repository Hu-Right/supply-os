# ===== 依赖与构建产物 =====
node_modules/
build/
dist/
coverage/
*.tsbuildinfo
.vite/
.cache/
.next/
.mimosa/

# ===== 敏感配置(保留 .env.example)=====
.env*
!.env.example
!.env.production.example

# ===== 日志与临时文件 =====
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
*.tmp
*.temp
~$*
*.swp
*.swo

# ===== scripts 分层：默认跟踪，按生命周期放置 =====
# 规则：长期门禁脚本放 scripts/gates/、持久手动工具放 scripts/tools/ —— 两者随目录自动入库，
#       新增脚本无需再改本文件（彻底告别逐条 ! 白名单与顺序陷阱）。
#       一次性 / 连生产库的探针 / 本机应急脚本放 scripts/ops/（默认忽略）；生成物落 out/backups。
# 一致性由 scripts/gates/check-gitignore-consistency.mjs 在 lint/CI 强制：禁散放、禁跟踪 ops。
/scripts/ops/
/scripts/out/
/scripts/backups/
**/.sync-watermark.json

# ===== 一次性数据库工具与运行产物（影子表蓝绿切换等，见 ADR-0003）=====
/runtime/

# ===== 服务器 / 本地运行目录 =====
/bin/
/dumps/
/logs/
/server/logs/
/backups/

# ===== IDE 与编辑器 =====
.qoder/
.zcode/
.vscode/
.idea/
*.suo
*.njsproj
*.sln
*.iws

# ===== 操作系统生成文件 =====
.DS_Store
.DS_Store?
._*
Thumbs.db
ehthumbs.db
Desktop.ini

# ===== 二进制与办公文档 =====
# 二进制 / 办公文档默认不入库（体量大、非源码、多为过程产物）。
# 需要随仓分发的运行必需资源，在下方「例外」区用 ! 精确放行。
*.docx
*.xlsx
*.pptx
*.pdf
*.zip
*.rar
*.7z
*.exe
*.dll
*.png
*.jpg
*.jpeg
*.gif
*.ico
*.woff
*.woff2
*.ttf
*.eot

# —— 项目运行必需的静态资源例外 ——
!public/fonts/**
!public/wechat-service-qr.png
!public/earth.png
!public/downloads/training/**
!public/images/training/**
!public/manifest.json
!src/app/favicon.ico/

# ===== 开发过程文档：仅 docs/adr/ 入库，其余（周报 / 收费资料 / 数据库设计等）本地 =====
# 必须用 docs/*（而非 docs/）才能让下方 !docs/adr/ 例外生效——git 不进入被整目录排除的路径
docs/*
!docs/adr/

# ===== 临时 / 个人过程文件（统一落 temp/，不再逐文件点名）=====
/temp/

# ===== Playwright E2E 测试产物 =====
playwright-report/
test-results/
blob-report/
