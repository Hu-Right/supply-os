# ── Database ──────────────────────────────────────────────────────
# MySQL connection pool. All values have safe defaults; only override when needed.
DB_HOST="127.0.0.1"
DB_PORT="3306"
DB_USER="root"
DB_PASSWORD="your-db-password"
DB_NAME="crm"
DB_POOL_LIMIT="10"

# ── 爬虫源库同步（scripts/tools/daily-sync.cjs，主表唯一写入者）─────────────
# 2026-11-13 起应用内 crawler-sync 已摘除：本组变量只由仓库根下的同步脚本读取
# （node scripts/tools/daily-sync.cjs，手动执行或部署层挂 cron），应用进程不再读它们。
# 该脚本与任何其它「爬虫库 → 主表」写入者不要同时运行，避免并发 ODKU 主表。
# 注：SYNC_WORKER_IN_APP 只控制应用内「宽表 / Meilisearch」对账任务，与源库同步无关。
SYNC_SOURCE_HOST=""
SYNC_SOURCE_PORT="3306"
SYNC_SOURCE_USER="root"
SYNC_SOURCE_PASSWORD=""
SYNC_SOURCE_DATABASE="crm"
# 源库表名前缀（默认空）。2026-10-28「去 crm_ 前缀」批次只改了云库与仓库代码；
# 内网源库还没改名时设 "crm_"（源库读 crm_bid_notices / crm_bid_opportunities，
# 目标库与 sync_watermark 键仍用现行名）。内网改名后清空即可。
SYNC_SOURCE_TABLE_PREFIX=""
# 同步间隔（毫秒），默认 1 小时（仅 daily-sync.cjs 持续运行模式使用）
SYNC_INTERVAL_MS="3600000"

# ── 搜索行为统计（首页「热门搜索」）──────────────────────────────────────
# 统一搜索端点会把检索行为写入 user_search_log（匿名也记：只存访客哈希 + 归一化词，
# 不存原始 IP/不存匿名原文），用于首页真实热门搜索聚合；关闭后热榜停更并回退数据覆盖榜。
SEARCH_LOG_ENABLED="on"
# 匿名访客哈希盐（生产必须配置随机值；为空会回退开发常量并告警一次）
SEARCH_LOG_HASH_SALT=""
# 检索日志保留天数（定时任务清理，默认 90 天）
SEARCH_LOG_RETENTION_DAYS="90"
# 不计入日志/热榜的用户 id（逗号分隔；测试与内部账号）
SEARCH_LOG_EXCLUDE_USER_IDS=""

# 首页热门搜索聚合口径（全部可调；默认值面向冷启动期，数据量起来后可上调门槛）：
# 窗口天数（默认 90；数据充足后建议降到 30 或 7）
HOT_SEARCH_WINDOW_DAYS="90"
# 返回条数（1..12，默认 8）
HOT_SEARCH_LIMIT="8"
# 单访客单词每窗口最多计几次（防刷，默认 3）
HOT_SEARCH_PER_VISITOR_CAP="3"
# 入榜门槛：去重访客数 / 封顶后搜索次数 / 有结果占比（默认 2 / 3 / 0.5）
HOT_SEARCH_MIN_VISITORS="2"
HOT_SEARCH_MIN_SEARCHES="3"
HOT_SEARCH_MIN_HIT_RATE="0.5"
# 整体展示门槛：窗口有效搜索数 / 合格词数，低于则 Hero 隐藏热门搜索行（默认 50 / 2）
HOT_SEARCH_MIN_TOTAL_SEARCHES="50"
HOT_SEARCH_MIN_QUALIFIED_TERMS="2"

# ── Payment ─────────────────────────────────────────────────────
# PAYMENT_MODE: "live" enables real payment strategies (Alipay/WeChat);
# "mock" (default) forces all orders through the mock provider for local testing.
PAYMENT_MODE="mock"

# Alipay (电脑网站支付 / 手机网站支付)
# 1. 在 https://open.alipay.com 创建应用，获取 APP ID
# 2. 使用支付宝密钥工具生成 RSA2(SHA256) 密钥对
# 3. 将应用公钥上传到开放平台，获取支付宝公钥
# 4. 沙箱环境: 在 https://open.alipay.com/develop/sandbox/app 获取沙箱配置
ALIPAY_APP_ID=""
ALIPAY_PRIVATE_KEY=""
ALIPAY_PUBLIC_KEY=""
ALIPAY_NOTIFY_URL=""
# 设为 "true" 使用沙箱网关 (openapi-sandbox.dl.alipaydev.com)
ALIPAY_SANDBOX="false"

# WeChat Pay (H5 支付 / Native 支付)
# 1. 在 https://pay.weixin.qq.com 注册商户号
# 2. 获取商户号(mchid)、API v3 密钥、商户 API 私钥
WECHAT_APP_ID=""
WECHAT_MCH_ID=""
WECHAT_API_V3_KEY=""
WECHAT_PRIVATE_KEY=""
WECHAT_NOTIFY_URL=""

# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# DEEPSEEK_API_KEY: 仅离线批处理脚本使用（scripts/tools/notice-attribution-content-ai.ts）。
# ⚠ 在线翻译自 2026-11-18 起改为「用户 BYOK」：调用用户在「设置 → AI 模型」绑定的
#   Key/端点/模型（user_llm_config），不再使用本变量，未配置 Key 的用户翻译会提示先配置。
# DEEPSEEK_BASE_URL 同上，仅批处理脚本使用，默认 https://api.deepseek.com。
DEEPSEEK_API_KEY="MY_DEEPSEEK_API_KEY"

# LLM_KEY_SECRET: AI 拆标摘要功能。用户自带 API Key 的加密密钥（AES-256-GCM）。
# 未配置时，保存用户 LLM 配置会报错（无法加密）。建议使用长随机字符串。
LLM_KEY_SECRET="change-me-to-a-long-random-secret"

# ── Meilisearch ──────────────────────────────────────────────────
# Meilisearch 搜索引擎（采购公告搜索加速）。
# 部署时运行 .\scripts\setup-meilisearch.ps1 自动下载二进制。
# MEILI_ENABLED=on 时激活搜索；不可用时搜索自动降级到 MySQL FULLTEXT。
MEILI_ENABLED="off"
MEILI_HOST="http://127.0.0.1:7700"
# MEILI_MASTER_KEY: Meilisearch 认证密钥，建议用随机字符串。
#   node -e "console.log(require('crypto').randomBytes(16).toString('hex'))"
MEILI_MASTER_KEY=""
# MEILI_MAX_TOTAL_HITS: 搜索可翻页结果上限；默认 10000000，避免 Meilisearch 默认 1000 导致总数显示过少。
MEILI_MAX_TOTAL_HITS="10000000"

# ── Misc ────────────────────────────────────────────────────────
# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# ALERT_WEBHOOK_URL: Optional. Cron patrol health-check failures (bridge dirty count
# exceeding threshold / DB unreachable / cleanup not converging) are POSTed to this
# webhook as JSON; when unset, alerts are only appended to scripts/cron-logs/*.log.
ALERT_WEBHOOK_URL=""

# ── JWT 身份认证 ─────────────────────────────────────────────
# JWT_SECRET: 用于签发和验证 Access/Refresh Token 的密钥。
# 生产环境必须配置；缺失时身份认证不可用。
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=""

# ── 邮件退订 ─────────────────────────────────────────────
# UNSUBSCRIBE_SECRET: 校验 /unsubscribe?token=... 的 HMAC 密钥，必须与
# intelligence-daily server 配置同一个值；缺失时退订页一律判定链接无效。
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
UNSUBSCRIBE_SECRET=""

# ── CSRF 现状（2026-09-05 审查确认）────────────────────────────────────
# ⚠️ 以下配置项当前未在 src/ 中实现任何校验逻辑，仅为预留占位。
# 实际缓解：写请求依赖 Authorization: Bearer 头（浏览器不会自动附加，天然免疫经典 CSRF）；
# Refresh Cookie 为 SameSite=Strict 且 Path=/api/auth 限定。风险整体可控。
# 如未来需启用 CSRF 校验，请在此配置并在 src/lib/middleware/ 中实现。
# ALLOWED_ORIGINS=""
# CSRF_ENABLED="false"

# ── 局域网调试来源白名单（仅 next dev 生效）───────────────────────
# Next.js 16 会拦截跨源的 dev 内部请求：浏览器地址栏的 host 不在名单内时，
# HMR WebSocket 握手被拒 → 页面 JS 加载不全 → 点击按钮无反应（表现为 /_next/* 403/404）。
# 本机 LAN IP 随 DHCP 变化时只改这里，无需改 next.config.ts；改完必须重启 dev。
# 逗号分隔；localhost 由 Next 默认放行，无需列出。
# 注意：与上方预留的 ALLOWED_ORIGINS（生产 CORS/CSRF）无关。
DEV_ALLOWED_ORIGINS="172.16.2.206,192.168.1.200"

# ── SMTP 邮件服务 ─────────────────────────────────────────────
# 用于发送找回密码验证码等系统邮件
# 阿里云邮件推送：smtpdm.aliyun.com / 腾讯云 SES：smtp.tencentcloud.com
# 发件域用平台自有域的独立发信子域 mail.osneosmart.com（与官网/营销隔离发信信誉）。
# 前置条件：DirectMail 控制台添加该发信域名，并按提示配好 SPF/DKIM（CNAME/TXT）与
# _dmarc.osneosmart.com；否则海外收件方（Gmail/Outlook）会判垃圾或直接拒收。
# 上线前自检：npm run check:email-dns -- --domain mail.osneosmart.com
SMTP_HOST="smtpdm.aliyun.com"
SMTP_PORT="465"
SMTP_USER="noreply@mail.osneosmart.com"
SMTP_PASS="your-smtp-password"
SMTP_FROM="云境·国际采购平台 <noreply@mail.osneosmart.com>"
# 回复地址（可选）：填公司真实可收信邮箱，用户点「回复」才不会回到 noreply。
# osneosmart.com 当前没有 MX，过渡期可先用 neosilks.com 上的邮箱，例如 service@neosilks.com
SMTP_REPLY_TO=""
# 应用侧 DKIM 签名（可选）：SMTP 服务商已在服务端签名时留空；
# 三项齐全才启用，私钥可在单行内用 \n 表示换行
SMTP_DKIM_DOMAIN=""
SMTP_DKIM_SELECTOR=""
SMTP_DKIM_PRIVATE_KEY=""

# 站外绝对链接单一事实源（邮件内链接/SEO；未设则代码回退 https://osneosmart.com）
SITE_URL="https://osneosmart.com"
# RFQ 契约哨兵周期对账（默认 on）
RFQ_GUARD_ENABLED="on"
# RFQ 发布邀约邮件群发（默认 off：需精确匹配与人工放行后再开）
RFQ_OUTREACH_ENABLED="off"

# ── Feature Flags（重构灰度控制）────────────────────────────
# 控制新功能的开启/关闭，默认全部关闭（"off"）。
# 设为 "on" 启用对应功能，回滚时改回 "off" 即可。
# 详见 src/core/flags.ts
FEATURE_NEW_HOME="off"
FEATURE_ADVANCED_SEARCH="off"
FEATURE_NOTICE_DETAIL_ENHANCED="off"
FEATURE_SUPPLIER_LIBRARY_ENHANCED="off"
FEATURE_SUPPLIER_PROFILE="off"
FEATURE_AWARD_INTELLIGENCE="off"
FEATURE_MEMBERSHIP_TIERS_V2="off"
FEATURE_CRM_AUTH_GUARD="off"
FEATURE_SAVED_SEARCH="off"
FEATURE_RFQ="off"
FEATURE_KNOWLEDGE_CENTER_V2="off"
FEATURE_SERVICES_LIFECYCLE="off"
FEATURE_SHOWROOM_MAP="off"
FEATURE_TRAINING_V2="off"

# ── 短信服务（阿里云 SMS）────────────────────────────────────────
# SMS_PROVIDER: "aliyun" 使用阿里云短信；"mock" 仅控制台打印（本地开发）
SMS_PROVIDER="mock"
SMS_ACCESS_KEY_ID=""
SMS_ACCESS_KEY_SECRET=""
SMS_SIGN_NAME=""
# 默认模板（用于手机号绑定/解绑/换绑场景）
SMS_TEMPLATE_CODE=""
# 找回密码专用模板（可选，未配置时复用默认模板）
SMS_TEMPLATE_CODE_RESET=""
# 国际/港澳台短信（新版「国际/港澳台 API」：SendMessageToGlobe，无需签名/模板）
# 手机号全站按 E.164 存储（+8613800138000 / +85291234567）：+86 走上面的国内签名+模板，
# 其余走国际通道。Sender ID 可在短信控制台「国际/港澳台短信 → 国际消息设置」获取/配置；
# 部分国家/地区还要求先向阿里云报备 Sender ID。未配置时非 +86 号码返回“通道未开通”。
# 可选：Sender ID（不配则由阿里云使用默认 Sender ID；部分国家/地区要求先报备自有 Sender ID）
SMS_INTL_SENDER_ID=""
# 可选：国际短信 API 端点（默认 dysmsapi.ap-southeast-1.aliyuncs.com，国际/港澳台 API 专用；国内端点不支持）
SMS_INTL_ENDPOINT=""
# 可选：自定义国际短信正文（{code} 会替换为验证码）；不配则用内置英文文案
SMS_INTL_MESSAGE_VERIFY=""
SMS_INTL_MESSAGE_RESET=""

# ── 应用文件日志目录（可选）──────────────────────────────────
# createLogger 输出目录，不配则落 <cwd>/logs
# LOG_DIR="./logs"

# ── 采购需求邀约分发（2026-11-15）──────────────────────────────
# 总开关：默认关闭（代码里也是 fail-closed）。等"匹配 → 触达 → 应标"整条链路跑通再改 on。
PROCUREMENT_INVITE_ENABLED=off
# 外部邮件：默认关闭。供应商邮箱多为采集所得，未经显式开启不得群发。
PROCUREMENT_INVITE_EMAIL=off
# 单条需求邀约上限 / 同供应商冷却期天数 / 冷却期内最多接收条数
PROCUREMENT_INVITE_LIMIT=30
PROCUREMENT_INVITE_COOLDOWN_DAYS=7
PROCUREMENT_INVITE_COOLDOWN_MAX=3