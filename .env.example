# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# YOUDAO_APP_KEY / YOUDAO_APP_SECRET: Optional. Translation channel #1 (Youdao Zhiyun).
# Both the app id (应用ID) AND app secret (应用密钥) are required to sign requests;
# when either is unset or left as placeholder, the chain skips Youdao and
# falls back to the next channel.
YOUDAO_APP_KEY="MY_YOUDAO_APP_KEY"
YOUDAO_APP_SECRET="MY_YOUDAO_APP_SECRET"

# DEEPSEEK_API_KEY: Optional. Translation channel #2 (DeepSeek V4-Pro, thinking effort=max).
# OpenAI-compatible ChatCompletions endpoint; when unset or left as placeholder,
# the chain skips DeepSeek and falls back to the Gemini channel directly.
# DEEPSEEK_BASE_URL is optional and defaults to https://api.deepseek.com.
DEEPSEEK_API_KEY="MY_DEEPSEEK_API_KEY"

# NOTICE_AUTO_TRANSLATE: Optional. In-server scheduled job that pre-translates the
# titles of newly crawled notices into Simplified Chinese (so Chinese keyword search
# can match them). Set to "off" to disable. Descriptions are still translated on demand
# when a user opens the notice detail page.
# NOTICE_AUTO_TRANSLATE_INTERVAL_MS defaults to 600000 (10 minutes).
# NOTICE_AUTO_TRANSLATE_MAX defaults to 300 notices per round.
NOTICE_AUTO_TRANSLATE="on"
NOTICE_AUTO_TRANSLATE_INTERVAL_MS="600000"
NOTICE_AUTO_TRANSLATE_MAX="300"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# ALERT_WEBHOOK_URL: Optional. Used by scripts/cron-patrol-and-clean.mjs (daily
# dirty-bridge patrol scheduled task). When set, CRITICAL alerts (new dirty rows
# exceeding threshold / DB unreachable / cleanup not converging) are POSTed to this
# webhook as JSON; when unset, alerts are only appended to scripts/cron-logs/*.log.
ALERT_WEBHOOK_URL=""
