# ── Database ──────────────────────────────────────────────────────
# MySQL connection pool. All values have safe defaults; only override when needed.
DB_HOST="127.0.0.1"
DB_PORT="3306"
DB_USER="root"
DB_PASSWORD="123456"
DB_NAME="crm"
DB_POOL_LIMIT="10"

# ── Payment ─────────────────────────────────────────────────────
# PAYMENT_MODE: "live" enables real payment strategies (Alipay/WeChat);
# "mock" (default) forces all orders through the mock provider for local testing.
PAYMENT_MODE="mock"

# Alipay (电脑网站支付 / 手机网站支付)
# 1. 在 https://open.alipay.com 创建应用，获取 APP ID
# 2. 使用支付宝密钥工具生成 RSA2(SHA256) 密钥对
# 3. 将应用公钥上传到开放平台，获取支付宝公钥
# 4. 沙箱环境: 在 https://open.alipay.com/develop/sandbox/app 获取沙箱配置
ALIPAY_APP_ID=""
ALIPAY_PRIVATE_KEY=""
ALIPAY_PUBLIC_KEY=""
ALIPAY_NOTIFY_URL=""
# 设为 "true" 使用沙箱网关 (openapi-sandbox.dl.alipaydev.com)
ALIPAY_SANDBOX="false"

# WeChat Pay (H5 支付 / Native 支付)
# 1. 在 https://pay.weixin.qq.com 注册商户号
# 2. 获取商户号(mchid)、API v3 密钥、商户 API 私钥
WECHAT_APP_ID=""
WECHAT_MCH_ID=""
WECHAT_API_V3_KEY=""
WECHAT_PRIVATE_KEY=""
WECHAT_NOTIFY_URL=""

# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# DEEPSEEK_API_KEY: Optional. Translation channel #1 (DeepSeek V4-Flash).
# OpenAI-compatible ChatCompletions endpoint; when unset or left as placeholder,
# the chain skips DeepSeek and falls back to the Gemini channel directly.
# DEEPSEEK_BASE_URL is optional and defaults to https://api.deepseek.com.
DEEPSEEK_API_KEY="MY_DEEPSEEK_API_KEY"

# 自动翻译
NOTICE_AUTO_TRANSLATE="on"
NOTICE_AUTO_TRANSLATE_INTERVAL_MS="600000"
NOTICE_AUTO_TRANSLATE_MAX="300"
NOTICE_AUTO_TRANSLATE_DESC_MAX_CHARS="8000"
NOTICE_AUTO_TRANSLATE_DAILY_CHARS="7000000"

# ── Meilisearch ─────────────────────────────────────────────────
# Meilisearch 搜索引擎（采购公告搜索加速）。
# 部署时运行 .\scripts\setup-meilisearch.ps1 自动下载二进制。
# MEILI_ENABLED=on 时激活搜索；不可用时搜索自动降级到 MySQL FULLTEXT。
MEILI_ENABLED="off"
MEILI_HOST="http://127.0.0.1:7700"
# MEILI_MASTER_KEY: Meilisearch 认证密钥，建议用随机字符串。
#   node -e "console.log(require('crypto').randomBytes(16).toString('hex'))"
MEILI_MASTER_KEY=""

# ── Misc ────────────────────────────────────────────────────────
# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# ALERT_WEBHOOK_URL: Optional. Cron patrol health-check failures (bridge dirty count
# exceeding threshold / DB unreachable / cleanup not converging) are POSTed to this
# webhook as JSON; when unset, alerts are only appended to scripts/cron-logs/*.log.
ALERT_WEBHOOK_URL=""

# ADMIN_API_TOKEN: Required to call ops endpoints (POST /api/admin/sync-bridge).
# Requests must carry the token via "x-admin-token: <token>" header or
# "Authorization: Bearer <token>". When unset, protected admin endpoints are
# disabled entirely (fail-closed, HTTP 503). Generate a strong random value, e.g.:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_API_TOKEN=""
