# ── Database ──────────────────────────────────────────────────────
# MySQL connection pool. All values have safe defaults; only override when needed.
DB_HOST="127.0.0.1"
DB_PORT="3306"
DB_USER="root"
DB_PASSWORD="123456"
DB_NAME="crm"
DB_POOL_LIMIT="10"

# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# DEEPSEEK_API_KEY: Optional. Translation channel #1 (DeepSeek V4-Flash).
# OpenAI-compatible ChatCompletions endpoint; when unset or left as placeholder,
# the chain skips DeepSeek and falls back to the Gemini channel directly.
# DEEPSEEK_BASE_URL is optional and defaults to https://api.deepseek.com.
DEEPSEEK_API_KEY="MY_DEEPSEEK_API_KEY"

# NOTICE_AUTO_TRANSLATE: Optional. In-server scheduled job that pre-translates newly
# crawled notices (above the id watermark) into both Simplified Chinese and English.
# Source language is auto-detected (zh→en, en→zh, minor languages→zh+en).
# Both title and description are translated; descriptions exceeding DESC_MAX_CHARS
# are skipped and left for on-demand translation at the detail endpoint.
# Set to "off" to disable entirely (on-demand translation is unaffected).
# NOTICE_AUTO_TRANSLATE_INTERVAL_MS defaults to 600000 (10 minutes).
# NOTICE_AUTO_TRANSLATE_MAX defaults to 300 notices per round per language.
# NOTICE_AUTO_TRANSLATE_DESC_MAX_CHARS: descriptions exceeding this many characters
#   are skipped by the scheduled job and translated on-demand instead (default 8000).
# NOTICE_AUTO_TRANSLATE_DAILY_CHARS: daily source-character budget; once exhausted,
#   the scheduled job pauses until the next calendar day (default 7000000).
NOTICE_AUTO_TRANSLATE="on"
NOTICE_AUTO_TRANSLATE_INTERVAL_MS="600000"
NOTICE_AUTO_TRANSLATE_MAX="300"
NOTICE_AUTO_TRANSLATE_DESC_MAX_CHARS="8000"
NOTICE_AUTO_TRANSLATE_DAILY_CHARS="7000000"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# ALERT_WEBHOOK_URL: Optional. Cron patrol health-check failures (bridge dirty count
# exceeding threshold / DB unreachable / cleanup not converging) are POSTed to this
# webhook as JSON; when unset, alerts are only appended to scripts/cron-logs/*.log.
ALERT_WEBHOOK_URL=""

# ADMIN_API_TOKEN: Required to call ops endpoints (POST /api/admin/sync-bridge).
# Requests must carry the token via "x-admin-token: <token>" header or
# "Authorization: Bearer <token>". When unset, protected admin endpoints are
# disabled entirely (fail-closed, HTTP 503). Generate a strong random value, e.g.:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_API_TOKEN=""
