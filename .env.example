# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# DEEPL_API_KEY: Optional. Translation channel #1 (DeepL API Free, 500K chars/month).
# When unset or left as placeholder, the chain skips DeepL.
DEEPL_API_KEY="MY_DEEPL_API_KEY"

# MYMEMORY_EMAIL: Optional. Translation channel #2 (MyMemory free API).
# Providing a contact email raises the quota from 5K to 50K chars/day.
# When unset or left as placeholder, the chain skips MyMemory.
MYMEMORY_EMAIL="MY_CONTACT_EMAIL"

# TRANSLATION_AR_PROVIDER: "chain" (default) or "gemini".
# Set to "gemini" to route Arabic translations straight to the LLM channel
# (quality switch for the RTL language).
TRANSLATION_AR_PROVIDER="chain"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"
